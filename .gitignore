# ---------- 密钥（最高优先级，绝对不能提交）----------
.env
.env.*
!.env.example

# ---------- Python ----------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
# 注意：.python-version 要入库！它锁定 Python 3.12，保证协作方拿到同样的版本。
# 这也是为什么要锁 3.12 而不是 3.14：生态兼容性。

# ---------- 工具缓存 ----------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# ---------- 运行时产物 ----------
# 本地数据、上传的文档、向量索引、导出的报告都不入库
data/
uploads/
artifacts/
*.sqlite3
*.db
*.log

# ---------- 编辑器 / 系统 ----------
.DS_Store
.idea/
.vscode/

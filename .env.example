# ============================================================
# 复制成 .env 再填真实值：  cp .env.example .env
# .env 已经在 .gitignore 里，不会被提交。
# 密钥只走环境变量，这是项目 constitution 里的安全红线之一。
# ============================================================

# ---------- 阿里云百炼（DashScope / 千问）----------
# 控制台：https://bailian.console.aliyun.com/  →  右上角「API-KEY」
# 注意：百炼的 API Key 是「按地域绑定」的。用北京的 key 就只能调北京的 endpoint，
#       混用会返回 401 invalid_api_key（不是 key 失效，是地域不匹配）。
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# 先用老域名（不需要 WorkspaceId，D1 上手最快）。
# 官方已推出更稳的新域名：https://{你的WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# WorkspaceId 在百炼控制台「业务空间详情」页。等链路跑通后再迁移，别在 D1 折腾这个。
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 以控制台「模型广场」里实际可用、且你有额度/已开通的模型名为准。
# 官方文档示例里出现过 qwen3.8-max、qwen-plus；视觉用 qwen-vl-* 系列。
DASHSCOPE_TEXT_MODEL=qwen-plus
DASHSCOPE_VISION_MODEL=qwen-vl-max

# ---------- 火山方舟（Ark / 豆包）----------
# 控制台：https://console.volcengine.com/ark  →  API Key 管理
# 方舟兼容 OpenAI 规范，所以同一套 openai SDK 可以直接用，只是换 base_url。
ARK_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3/

# 方舟的模型名通常带日期后缀（形如 doubao-seed-2-1-pro-260628）。
# 这些名字会随版本更新，务必去控制台「开通管理」里复制当前可用的模型名/推理接入点 ID。
ARK_TEXT_MODEL=doubao-seed-2-1-pro-260628
ARK_VISION_MODEL=

# ---------- 运行参数 ----------
# 默认走哪家：dashscope | ark
LLM_PROVIDER=dashscope
REQUEST_TIMEOUT_SECONDS=60
MAX_RETRIES=2
